# Copy to .env and adjust. All values are optional; defaults live in app/config/settings.py.

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
# Set to false to keep raw query text out of logs.
LOG_QUERIES=true

# --- Lexical retrieval: auto | elasticsearch | memory ---
# auto = use Elasticsearch if it answers a ping, otherwise the in-memory BM25 fallback.
BM25_BACKEND=auto
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=documents

# --- Models ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
SPACY_MODEL=en_core_web_sm

# --- Artifact paths (relative paths resolve from the working directory) ---
FAISS_INDEX_PATH=data/processed/faiss.index
DOCUMENT_STORE_PATH=data/processed/documents.json
EMBEDDING_CACHE_PATH=data/processed/embedding_cache.npz
INTENT_MODEL_PATH=data/processed/models/intent_classifier.joblib
RERANKER_MODEL_PATH=data/processed/models/reranker.joblib

# --- Startup ---
LOAD_SAMPLE_ON_STARTUP=true
AUTO_TRAIN_MODELS=true

# --- Hybrid retrieval ---
RRF_K=60
CANDIDATE_K=30

# --- DBSCAN / duplicate detection ---
DBSCAN_EPS=0.75
DBSCAN_MIN_SAMPLES=2
DUPLICATE_CANDIDATE_THRESHOLD=0.90
DUPLICATE_CONFIRM_THRESHOLD=0.95
DUPLICATE_JACCARD_THRESHOLD=0.5
EXCLUDE_OUTLIERS_FROM_INDEX=false
